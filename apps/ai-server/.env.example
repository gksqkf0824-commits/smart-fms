AI_SERVER_ENVIRONMENT=local
AI_SERVER_CORS_ORIGINS=["http://localhost:3000"]

# 모델 경로 (ai-server 루트 기준 상대경로 또는 절대경로)
AI_SERVER_DETECTION_MODEL_PATH=app/ml/trash_occupy_detection_best.pt
AI_SERVER_SEGMENTATION_MODEL_PATH=app/ml/stain_seg.pt

# 운영 정책값
AI_SERVER_DETECTION_CONF_THRESHOLD=0.6
AI_SERVER_SEGMENTATION_CONF_THRESHOLD=0.25
AI_SERVER_TRASH_LARGE_AREA_RATIO=0.01
